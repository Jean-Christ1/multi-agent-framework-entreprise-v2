# JAF - Jems Agent Framework
# Environment Configuration
# Copy this file to .env and customize values

# =============================================================================
# Application Settings
# =============================================================================

# Debug mode (enables verbose logging)
DEBUG=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# API Settings
# =============================================================================

# API server host and port
API_HOST=0.0.0.0
API_PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# Database Settings
# =============================================================================

# PostgreSQL connection URL (async driver)
DATABASE_URL=postgresql+asyncpg://jaf:jaf_password@localhost:5432/jaf

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# =============================================================================
# LLM Settings
# =============================================================================

# OpenAI API key (required for LLM operations)
OPENAI_API_KEY=sk-your-api-key-here

# Default LLM model
DEFAULT_MODEL=gpt-4o-mini

# Default sampling temperature (0.0 = deterministic)
DEFAULT_TEMPERATURE=0.0

# LLM request timeout in seconds
LLM_TIMEOUT=60

# Rate limiting (requests per minute)
LLM_MAX_RPM=10

# =============================================================================
# Engine Settings
# =============================================================================

# Default execution engine (crewai, native)
DEFAULT_ENGINE=crewai

# Enable CrewAI verbose mode (for debugging)
CREWAI_VERBOSE=false

# =============================================================================
# Feature Flags
# =============================================================================

# Enable database persistence
ENABLE_PERSISTENCE=true

# Enable event bus for real-time updates
ENABLE_EVENTS=true

# Enable Prometheus metrics endpoint
ENABLE_METRICS=false
